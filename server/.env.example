# ShareBite Server Configuration

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=sharebite-super-secret-jwt-key-2026

# PostgreSQL Connection String (Local PostgreSQL, Neon, Supabase, ElephantSQL, etc.)
# If left empty, ShareBite automatically runs in a high-fidelity local state mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharebite

# Optional Individual PostgreSQL Variables:
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=sharebite
# PGPORT=5432
# DATABASE_SSL=false
